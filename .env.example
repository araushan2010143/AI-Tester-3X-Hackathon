# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — defaults to gemini-flash-latest
# (gemini-2.5-flash is deprecated for new API keys as of mid-2026)
GEMINI_MODEL=gemini-flash-latest

# Optional — enables the "GitHub PR" evidence field in Single Test mode, which fetches a PR's
# diff so the diagnosis can be grounded in the actual code change instead of inferred from logs.
# Create a fine-grained token at https://github.com/settings/personal-access-tokens/new scoped to
# just the repo(s) you want readable, with "Pull requests: Read-only" — no write access needed.
GITHUB_TOKEN=

# --- Optional AI provider fallback ---
# Gemini is always tried first. If it's unavailable (overloaded, rate-limited, or
# GEMINI_API_KEY isn't set), the app automatically fails over to OpenAI, then Groq, in that
# order — whichever of these are actually configured. Neither is required; leave both blank to
# keep the app exactly as Gemini-only.

# Get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional — defaults to gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Get a key from https://console.groq.com/keys
GROQ_API_KEY=
# Optional — defaults to llama-3.3-70b-versatile (verify this is still current in your Groq
# console; Groq's hosted model lineup changes faster than most providers')
GROQ_MODEL=llama-3.3-70b-versatile
